# =============================================================================
# Production .dockerignore - Root Context
# Ensures minimal Docker build context, fast caching, and zero secret leakage
# =============================================================================

# 1. Host Dependencies (Always build cleanly inside container)
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 2. Version Control & CI/CD
.git/
.gitignore
.gitattributes
.github/
.gitlab-ci.yml

# 3. Environment & Secret Files (Never bake secrets into images)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# 4. Tests, Coverage & Quality Tooling
tests/
**/tests/
coverage/
.nyc_output/
*.test.js
*.spec.js

# 5. Documentation & Task Files (Keeps Docker image lean)
*.md
!README.md
*.pdf
docs/
ARCHITECTURE_DESIGN.md

# 6. Database Seed Scripts (Handled via dedicated DB volume/init container)
db/

# 7. OS & IDE Configuration
.DS_Store
.DS_Store?
._*
.idea/
.vscode/
*.swp
*.swo
*~

# 8. Temporary Files & Local Backups
tmp/
temp/
scratch/
backups/
*.tmp
*.bak
*.sql.gz
docker-compose*.yml
